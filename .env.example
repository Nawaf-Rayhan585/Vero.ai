# Copy to .env and set real values. .env is gitignored — never commit it.
# Used by docker-compose.yml (POSTGRES_*) and by the backend (DATABASE_URL).
POSTGRES_USER=vero
POSTGRES_PASSWORD=change-me
POSTGRES_DB=vero
# Host port 5433 (not 5432) to avoid clashing with other local Postgres instances.
POSTGRES_PORT=5433
# Must match the POSTGRES_* values above.
DATABASE_URL=postgresql+psycopg://vero:change-me@127.0.0.1:5433/vero
# Encrypts stored camera passwords at rest. Generate one with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Losing/changing this key makes previously stored camera passwords unrecoverable.
CAMERA_CREDENTIALS_KEY=change-me
# Signs login (access/refresh) tokens. Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
# At least 32 characters; there is no default. Changing it signs every user out.
AUTH_SECRET_KEY=change-me
# Optional (Phase 13) — only needed to actually run cloud-engine / put an organization on
# the Vero Cloud plan. Shared secret backend and cloud-engine both check on every
# request between them. Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
CLOUD_ENGINE_INTERNAL_SECRET=change-me
# Optional (Phase 13) — where backend reaches cloud-engine. Leave unset in a normal
# Own-Hardware-only dev setup; a Vero Cloud organization's camera gets a clear 503
# instead of silently running locally if this is unset.
CLOUD_ENGINE_BASE_URL=http://127.0.0.1:8002
