# Copy to .env and set real values. .env is gitignored — never commit it.
# Used by docker-compose.yml (POSTGRES_*) and by the backend (DATABASE_URL).
POSTGRES_USER=vero
POSTGRES_PASSWORD=change-me
POSTGRES_DB=vero
# Host port 5433 (not 5432) to avoid clashing with other local Postgres instances.
POSTGRES_PORT=5433
# Must match the POSTGRES_* values above.
DATABASE_URL=postgresql+psycopg://vero:change-me@127.0.0.1:5433/vero
# Encrypts stored camera passwords at rest. Generate one with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Losing/changing this key makes previously stored camera passwords unrecoverable.
CAMERA_CREDENTIALS_KEY=change-me
# Signs login (access/refresh) tokens. Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
# At least 32 characters; there is no default. Changing it signs every user out.
AUTH_SECRET_KEY=change-me
# Optional (Phase 13) — only needed to actually run cloud-engine / put an organization on
# the Vero Cloud plan. Shared secret backend and cloud-engine both check on every
# request between them. Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
CLOUD_ENGINE_INTERNAL_SECRET=change-me
# Optional (Phase 13) — where backend reaches cloud-engine. Leave unset in a normal
# Own-Hardware-only dev setup; a Vero Cloud organization's camera gets a clear 503
# instead of silently running locally if this is unset.
CLOUD_ENGINE_BASE_URL=http://127.0.0.1:8002
# Optional (Phase 15) — real PayPal billing for the Own Hardware plan. SANDBOX ONLY:
# create a free app at https://developer.paypal.com/dashboard/applications (no real
# business account, no real money) and copy its sandbox Client ID/Secret here. Leave
# unset to skip PayPal entirely — the manual override on the Subscription page still
# works without any of this.
PAYPAL_CLIENT_ID=change-me
PAYPAL_CLIENT_SECRET=change-me
# From the sandbox app's Webhooks section, after adding a webhook pointed at
# {PAYPAL_RETURN_BASE_URL}/subscription/paypal/webhook (needs a public HTTPS URL to
# actually receive anything — see docs/ROADMAP.md's Phase 15 entry for why that's not
# possible in a plain local dev setup without a tunnel).
PAYPAL_WEBHOOK_ID=change-me
# Printed by `python backend/scripts/setup_paypal_plan.py` after it creates the Own
# Hardware product+plan in your sandbox account (a one-time setup step, run once).
PAYPAL_OWN_HARDWARE_PLAN_ID=change-me
# Backend's own public-facing base URL — PayPal redirects the buyer's browser back here
# after approval/cancellation. http://127.0.0.1:8000 works for local testing (you'll see
# the confirmation page yourself after approving in your browser) but PayPal's own
# servers can never reach it for webhooks; only a real public URL can.
PAYPAL_RETURN_BASE_URL=http://127.0.0.1:8000
